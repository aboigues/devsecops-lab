#!/usr/bin/env bash
# Hook git pre-commit : refuse le commit si les modifications indexées contiennent un secret.
# Installation : cp pre-commit <dépôt>/.git/hooks/pre-commit && chmod +x <dépôt>/.git/hooks/pre-commit
# Contournable (git commit --no-verify) : c'est un confort pour le développeur, pas une gate.
# La gate, c'est le scan de l'historique en CI.
exec gitleaks git --pre-commit --staged --redact --no-banner --exit-code 1 .
